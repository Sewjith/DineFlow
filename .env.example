# Copy to .env and adjust as needed. Values here are safe local-dev defaults.

# ---- PostgreSQL ----
POSTGRES_DB=dineflow
POSTGRES_USER=dineflow
POSTGRES_PASSWORD=dineflow
POSTGRES_PORT=5432

# ---- JWT (shared across gateway + services) ----
# Must be a long random string (>= 32 chars) for HS256 signing.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# ---- Admin credentials (used by api-gateway login) ----
ADMIN_USERNAME=admin
# BCrypt hash of the admin password. Default below is the hash of "admin123".
ADMIN_PASSWORD_HASH=$2a$10$7EqJtq98hPqEX7fNZaFWoOa8Rl.QjQ3sJH0m9Yt5m5xW1cJ8h7bqS
