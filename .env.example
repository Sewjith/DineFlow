# Copy to .env and adjust as needed. Values here are safe local-dev defaults.

# ---- PostgreSQL ----
POSTGRES_DB=dineflow
POSTGRES_USER=dineflow
POSTGRES_PASSWORD=dineflow
# Host port for local dev (container-internal port is always 5432).
# 5433 avoids clashing with a native PostgreSQL commonly on 5432.
POSTGRES_PORT=5433

# ---- JWT (shared across gateway + services) ----
# Must be a long random string (>= 32 chars) for HS256 signing.
JWT_SECRET=dev-local-secret-please-change-me-32chars-min
JWT_EXPIRATION_MINUTES=120

# ---- Admin credentials (used by api-gateway login) ----
ADMIN_USERNAME=admin
# BCrypt hash of the admin password. Default below is the hash of "admin123".
# Generate your own: mvn -f backend/api-gateway/pom.xml exec:java \
#   -Dexec.mainClass=com.dineflow.gateway.security.PasswordHashTool -Dexec.args="yourPassword"
ADMIN_PASSWORD_HASH=$2a$10$pxdmOOkSyHcnZlLhRRVjCusWX8OKEA.5UmvEUS8oPuwOVjnfROWaa
